# Токен бота от @BotFather
BOT_TOKEN=

# Необязательно: ключ IQAir (https://dashboard.iqair.com, бесплатный тариф Community).
# С ключом индекс AQI берётся с реальных станций IQAir, без ключа — из модели CAMS (Open-Meteo).
IQAIR_API_KEY=

# Время сводки по умолчанию для новых пользователей (местное время их местности)
DEFAULT_NOTIFY_TIME=08:00

# Файл базы данных SQLite
DB_PATH=data/bot.db
